<Window
    x:Class="FluentZones.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="44" Padding="16,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <Image Source="Assets/titlebar.png" Width="16" Height="16"
                       VerticalAlignment="Center" />
                <TextBlock Text="Fluent Zones" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="14" />
                <TextBlock Text="窗口布局" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 分页：首页 / 偏好 / 热键 / 关于（左侧栏，Windows 设置样式） -->
        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="Left"
                        OpenPaneLength="220"
                        IsPaneOpen="True"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="首页" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="偏好" Tag="prefs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="热键" Tag="hotkeys">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="关于" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <ScrollViewer x:Name="ContentScroller" IsTabStop="True"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="920" Padding="24,12,24,24" Spacing="18">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <!-- 首页：6 个操作卡片 -->
                <StackPanel x:Name="HomePanel" Spacing="10">
                    <TextBlock Text="布局" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Grid x:Name="LayoutCardsHost" ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                    </Grid>
                    <TextBlock Text="提示：关闭窗口会退出程序；窗口最小化时热键依然生效。"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>

                <!-- 偏好 -->
                <StackPanel x:Name="PrefsPanel" Spacing="10" Visibility="Collapsed">
                    <TextBlock Text="偏好设置" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <StackPanel Spacing="8">
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection>
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </StackPanel.ChildrenTransitions>

                        <!-- 窗口间距 -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="16,12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="窗口间距" />
                                    <TextBlock Text="并排 / 网格时窗口之间留出的空隙"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Slider x:Name="GapSlider" Grid.Column="1" Minimum="0" Maximum="40"
                                        StepFrequency="1" VerticalAlignment="Center"
                                        ValueChanged="GapSlider_ValueChanged" />
                                <TextBlock x:Name="GapValueText" Grid.Column="2" Text="0 px"
                                           VerticalAlignment="Center" MinWidth="48"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>
                        </Border>

                        <!-- 作用范围 -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="16,12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="作用范围" />
                                    <TextBlock Text="“鼠标所在显示器”只会动当前屏幕上的窗口"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ComboBox x:Name="ScopeCombo" Grid.Column="1" MinWidth="160"
                                          VerticalAlignment="Center"
                                          SelectionChanged="ScopeCombo_SelectionChanged">
                                    <ComboBoxItem Content="鼠标所在显示器" />
                                    <ComboBoxItem Content="所有显示器" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- 启动：可展开的卡片，默认收起（Windows 设置里分组就是这个样子） -->
                        <Border x:Name="StartupCard"
                                Style="{StaticResource CardBorderStyle}"
                                Padding="0">
                            <Expander x:Name="StartupExpander"
                                      IsExpanded="False"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="0">
                                <Expander.Resources>
                                    <!-- 模板默认给标题行/展开区各铺一层卡片色，叠在卡片上会比别的卡更白；
                                         这里让它们透出卡片本身的底色 -->
                                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
                                    <!-- 悬停反馈放在整张卡片上（见 StartupCard_PointerEntered），
                                         不要只让箭头那一小块变灰 -->
                                    <SolidColorBrush x:Key="ExpanderChevronPointerOverBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="ExpanderChevronPressedBackground" Color="Transparent" />
                                </Expander.Resources>
                                <Expander.Header>
                                    <StackPanel Spacing="2" Margin="0,12,0,12">
                                        <TextBlock Text="启动" />
                                        <TextBlock Text="开机启动、管理员模式启动"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel x:Name="StartupContent" Spacing="0" Margin="0,0,0,6">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform />
                                    </StackPanel.RenderTransform>
                                    <Grid Padding="16,6,16,6" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="开机启动" />
                                            <TextBlock Text="登录 Windows 后在后台静默启动，直接可用热键"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="StartupStateText" Text="关" VerticalAlignment="Center" />
                                            <ToggleSwitch x:Name="StartupToggle" MinWidth="0"
                                                          OnContent="" OffContent=""
                                                          VerticalAlignment="Center"
                                                          Toggled="StartupToggle_Toggled" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Padding="16,6,16,6" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="管理员模式启动" />
                                            <TextBlock Text="启动时请求管理员权限（UAC，下次启动生效），可操作 Windhawk 这类提权窗口；MSIX 版不支持"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="ElevatedStateText" Text="关" VerticalAlignment="Center" />
                                            <ToggleSwitch x:Name="ElevatedToggle" MinWidth="0"
                                                          OnContent="" OffContent=""
                                                          VerticalAlignment="Center"
                                                          Toggled="ElevatedToggle_Toggled" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- 分区模式 -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="16,12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="分区模式" />
                                    <TextBlock Text="开启后选一个布局进入工作区，拖动分隔线两侧一起变（Ctrl+Alt+Z 开关）"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="ZoneStateText" Text="关" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="ZoneToggle" MinWidth="0"
                                                  OnContent="" OffContent=""
                                                  VerticalAlignment="Center"
                                                  Toggled="ZoneToggle_Toggled" />
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                </StackPanel>

                <!-- 热键 -->
                <StackPanel x:Name="HotkeysPanel" Spacing="10" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="全局热键" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Bottom"
                                   Text="按住 Shift 使用同一组合键 = 作用于所有显示器"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16,4">
                        <StackPanel x:Name="HotkeyRowsHost" Spacing="0" />
                    </Border>
                </StackPanel>

                <!-- 关于 -->
                <StackPanel x:Name="AboutPanel" Spacing="20" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Image Source="Assets/icon-preview.png" Width="52" Height="52" />
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Fluent Zones" Style="{StaticResource TitleTextBlockStyle}" FontSize="28" />
                            <TextBlock x:Name="VersionText" Text="版本 0.1.0"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Fluent 风格的 Windows 窗口布局 / 分区工具：按最小尺寸智能排布、可拖拽分区、全局热键，也能操作管理员程序的窗口。"
                               TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />

                    <StackPanel Spacing="8">
                        <TextBlock Text="链接" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                            <StackPanel x:Name="AboutLinksHost" />
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="本机数据" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Border Style="{StaticResource CardBorderStyle}" Padding="16,14">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8B7;" FontSize="16"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="设置保存在 settings.json" />
                                    <TextBlock Text="%LOCALAPPDATA%\FluentZones\settings.json"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="MIT License · 如果觉得好用，可以在 Microsoft Store 里以 ¥12 支持一下开发。"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
        </NavigationView>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Padding="16,8" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon x:Name="StatusIcon" FontSize="13" Glyph="&#xE946;" VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="StatusText" Text="正在启动…" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           TextWrapping="Wrap" MaxLines="2" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
